# ------------------------------------------------------------------
# Arshu Portfolio — environment template
# Copy to `.env.local` and adjust. Never commit real secrets.
# ------------------------------------------------------------------

# Public site URL. Used for canonical links, sitemap.xml, robots.txt
# and Open Graph metadata. Change this to your production domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Reserved placeholder — the public Mojang profile API needs NO key.
# If you later switch to a paid Minecraft API provider (e.g. a player-
# stats service), put its key here. It is only ever read on the server
# (app/api/minecraft/*) and must never be exposed to the client.
MINECRAFT_API_KEY=
